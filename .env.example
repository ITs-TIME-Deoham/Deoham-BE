# Copy to .env and fill in real values. .env is gitignored — never commit it.
# ./gradlew bootRun loads this file automatically (see build.gradle).
# docker compose (compose.yaml / compose-local.yaml) loads it via env_file.

# --- Required (no default in application-local.yml — app fails to start without these) ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GEMINI_API_KEY=

# --- Optional (defaults come from application-local.yml if omitted) ---
# JWT_SECRET=my-test-secret-key-minimum-32-characters-required
# KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
# AWS_S3_REGION=ap-northeast-2
# AWS_S3_BUCKET=ondo-2026-itstime
# GEMINI_MODEL=gemini-3.5-flash
# KAKAO_MAP_REST_API_KEY=

# --- AWS credentials for S3 (only needed if not already set via `aws configure` / SSO / IAM role) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
