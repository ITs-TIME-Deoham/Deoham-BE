<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty name="LOG_FILE_MAX_SIZE" source="logging.file.max-size" defaultValue="10MB"/>
  <springProperty name="LOG_FILE_MAX_HISTORY" source="logging.file.max-history" defaultValue="10"/>
  <springProperty name="LOKI_URL" source="loki.url" defaultValue="http://localhost:3100"/>

  <!-- Console Appender -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Loki Appender -->
  <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
    <url>${LOKI_URL}/loki/api/v1/push</url>
    <tenantId>deoham</tenantId>
    <batchSize>100</batchSize>
    <batchTimeoutMs>5000</batchTimeoutMs>
    <label>
      <pattern>app=deoham,host=${HOSTNAME},env=${SPRING_PROFILES_ACTIVE:local}</pattern>
    </label>
    <encoder class="com.github.loki4j.logback.JsonEncoder">
      <fieldNames>timestamp,level,thread,logger,message,exception</fieldNames>
      <messagePattern>%msg%n%exception{10}</messagePattern>
    </encoder>
  </appender>

  <!-- Spring Boot Default Loggers -->
  <logger name="org.springframework" level="INFO"/>
  <logger name="org.springframework.web" level="INFO"/>
  <logger name="org.hibernate" level="INFO"/>

  <!-- Application Loggers -->
  <logger name="com.deoham" level="INFO" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="LOKI"/>
  </logger>

  <!-- Root Logger -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="LOKI"/>
  </root>
</configuration>
